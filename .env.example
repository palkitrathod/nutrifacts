# ── Auth API (server/index.ts) ─────────────────────────────────────────────
# Port the API listens on. In development Vite (port 3000) proxies /api to it.
# In production one process serves both the API and the built site (default 3000).
# PORT=3001

# SQLite database file. The folder is created automatically.
# DATABASE_PATH=data/nutrifacts.db

# Sample patient + dietitian accounts (password Demo@1234).
# On by default in development, off in production.
# SEED_DEMO_USERS=true

# Real dietitian/admin login. When both are set, the admin account is
# created (or its email/password updated) on startup.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# New accounts allowed per IP address per hour (default 20).
# SIGNUPS_PER_HOUR_PER_IP=20

# Behind a reverse proxy / load balancer (nginx, Render, Railway…): number of proxies in front, usually 1.
# Leave unset when browsers connect directly.
# TRUST_PROXY=1

# Public URL(s) of the site, comma-separated. Needed if the proxy rewrites the Host header.
# PUBLIC_ORIGIN=https://app.nutrifacts.in

# Send the session cookie over HTTPS only. Defaults to true in production.
# COOKIE_SECURE=true

# ── Email (verification codes on sign-up) ──────────────────────────────────
# Any SMTP provider works: Gmail / Google Workspace (smtp.gmail.com, an App Password),
# Zoho (smtp.zoho.in), Brevo (smtp-relay.brevo.com), Amazon SES, SendGrid (user "apikey")…
# Without SMTP_HOST, emails are not sent: each one is saved as an .html file in
# MAIL_OUTBOX_DIR (default data/outbox) and the code is shown in the server log.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false            # true for port 465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Nutrifacts with Dt. Anchal <no-reply@nutrifacts.in>"
# MAIL_OUTBOX_DIR=data/outbox
# Force the outbox even when SMTP_* is set (automated tests use this).
# MAIL_TRANSPORT=outbox

# ── Legacy (AI Studio) ─────────────────────────────────────────────────────
# GEMINI_API_KEY is not used by any screen yet.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
